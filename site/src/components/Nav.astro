---
import Wordmark from './Wordmark.astro';
import { REPO, downloadPage, url } from '../data/site';

interface Props { home?: boolean }
const { home = true } = Astro.props;
const at = (hash: string) => (home ? hash : url(hash));
const links = [
  { href: at('#how'), label: 'How it works' },
  { href: at('#games'), label: 'Games' },
  { href: at('#compare'), label: 'Compare' },
  { href: at('#install'), label: 'Get started' },
  { href: url('setup/'), label: 'Setup' },
  { href: url('changelog/'), label: "What's new" },
  { href: url('docs/'), label: 'Docs' },
  { href: REPO, label: 'GitHub' },
];
---
<header class="nav">
  <div class="nav-in wrap">
    <a class="brand" href={url()}>
      <img src={url('favicon.svg')} alt="" width="30" height="30" />
      <Wordmark id="nav" />
    </a>
    <nav class="links" aria-label="Sections">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <button type="button" class="menu-btn" popovertarget="site-menu" aria-controls="site-menu">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      Menu
    </button>
    <a class="btn btn-primary btn-small dl" href={downloadPage()} data-download><span data-download-label>Download FramePort</span></a>
  </div>
  <!-- narrow windows and phones: the same links in a panel under the bar (Esc or a click outside closes it) -->
  <div id="site-menu" class="menu" popover>
    <nav aria-label="Sections">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <a class="btn btn-primary" href={downloadPage()} data-download><span data-download-label>Download FramePort</span></a>
  </div>
</header>

<script>
  // a link inside the menu closes it (in-page links don't navigate away)
  const menu = document.getElementById('site-menu');
  menu?.addEventListener('click', (e) => { if ((e.target as Element).closest('a')) menu.hidePopover?.(); });
</script>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: rgba(17, 18, 23, 0.82);
    -webkit-backdrop-filter: blur(12px) saturate(1.2); backdrop-filter: blur(12px) saturate(1.2);
  }
  /* the app's sidebar edge, laid down: blue to orange */
  .nav::after { content: ""; position: absolute; inset: auto 0 0 0; height: 2px; background: var(--portal); opacity: 0.7; }
  .nav-in { display: flex; align-items: center; gap: 24px; min-height: 64px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; }
  .brand img { border-radius: 7px; }
  .links { display: flex; gap: 2px; margin-left: auto; }
  .links a, .menu a:not(.btn) { padding: 8px 12px; border-radius: var(--radius-sm); color: var(--text-2); text-decoration: none;
    font: 500 14px/20px var(--font-sans); white-space: nowrap; }
  .links a:hover, .menu a:not(.btn):hover { color: var(--text); background: rgba(237, 238, 242, 0.06); }
  [data-download-label] { font-size: 13px; }

  .menu-btn { display: none; align-items: center; gap: 8px; margin-left: auto; min-height: 44px; padding: 0 14px;
    border: 1px solid var(--border-strong); border-radius: var(--radius-sm); background: transparent; color: var(--text);
    font: 600 14px/1 var(--font-sans); cursor: pointer; }
  .menu-btn svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
  .menu-btn:hover { background: rgba(237, 238, 242, 0.06); }
  .menu-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .menu { position: fixed; inset: 66px 0 auto 0; margin: 0; width: 100%; max-height: calc(100dvh - 66px); overflow-y: auto;
    padding: 8px var(--gutter) 20px; border: 0; border-bottom: 1px solid var(--border-strong); background: var(--sidebar);
    color: var(--text); box-shadow: 0 18px 40px rgba(0, 0, 0, .55); }
  .menu nav { display: grid; margin-bottom: 14px; }
  .menu a:not(.btn) { display: flex; align-items: center; min-height: 48px; font-size: 16px; color: var(--text);
    border-bottom: 1px solid var(--border); border-radius: 0; }
  .menu .btn { width: 100%; }
  .menu .btn [data-download-label] { font-size: 15px; }

  /* the eight links fit one row only in wide windows; below that they move into the menu */
  @media (max-width: 1120px) {
    .links { display: none; }
    .menu-btn { display: inline-flex; }
    .nav-in { gap: 12px; }
  }
  /* phones: the bar keeps the brand and the menu; the download (for the PC) waits in the menu */
  @media (max-width: 560px) {
    .nav-in > .dl { display: none; }
  }
</style>
